 "classification": {
  "mamdani_vs_simpful": "Same scores within rounding: same operators, same sampled centroid.",
  "mamdani_vs_scikit_fuzzy": {
   "label": "formula form (quadrature)",
   "explanation": "bulanik and simpful take sum(x mu) / sum(mu) over the samples, a rectangle rule that counts the universe endpoints in full; skfuzzy integrates the piecewise-linear set exactly. The gap shrinks about tenfold for each tenfold rise in resolution.",
   "rectangle_rule_on_scikit_aggregate_vs_bulanik": 2.842170943040401e-14
  },
  "bisector_vs_scikit_fuzzy": "formula form (quadrature): bulanik returns the first sample at which the running sum reaches half; skfuzzy solves for the exact area split. On a low flat stretch the endpoint weight moves the split by more than one grid step.",
  "sugeno_vs_simpful_with_weights": {
   "label": "formula form",
   "explanation": "With rule weights, bulanik computes sum(w a f) / sum(w a), simpful sum(w a f) / sum(a): simpful weights the numerator only. Without weights they agree (the row 'mixed, weights removed'). bulanik has no option for simpful's form; rebuilding it from bulanik's rule activations reproduces simpful.",
   "rebuilt_simpful_form_vs_simpful": 1.4210854715202004e-14
  }
 },
